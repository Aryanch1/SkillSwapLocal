{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F5FA8",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.aryanmouli.skillswaplocal"
    },
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.aryanmouli.skillswaplocal",
      "supportsTablet": true
    },
    "name": "SkillSwapLocal",
    "orientation": "portrait",
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF6EE",
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      "@react-native-google-signin/google-signin",
      "expo-image-picker"
    ],
    "scheme": "skillswaplocal",
    "slug": "skillswaplocal",
    "userInterfaceStyle": "light",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "static"
    }
  }
}
